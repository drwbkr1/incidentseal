{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/drwbkr1/incidentseal/main/schemas/run-event-v1.schema.json",
  "title": "IncidentSeal run event v1",
  "description": "One append-only JSONL event. Lifecycle and verification verdict are intentionally independent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "sequence",
    "occurred_at_utc",
    "event_type",
    "lifecycle",
    "verdict",
    "terminal",
    "manifest_digest",
    "approval_digest",
    "payload",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": "incidentseal-run-event/v1"
    },
    "event_id": {
      "$ref": "#/$defs/uuid"
    },
    "run_id": {
      "$ref": "#/$defs/uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "occurred_at_utc": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "event_type": {
      "enum": [
        "run.queued",
        "run.started",
        "policy.checked",
        "step.started",
        "step.completed",
        "step.failed",
        "evidence.recorded",
        "run.completed",
        "run.cancelled",
        "run.failed",
        "run.stale",
        "run.superseded"
      ]
    },
    "lifecycle": {
      "enum": ["queued", "running", "completed", "cancelled", "failed", "stale", "superseded"]
    },
    "verdict": {
      "oneOf": [
        {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "INVALID"]},
        {"type": "null"}
      ]
    },
    "terminal": {
      "type": "boolean"
    },
    "manifest_digest": {
      "$ref": "#/$defs/sha256"
    },
    "approval_digest": {
      "$ref": "#/$defs/sha256"
    },
    "payload": {
      "type": "object"
    },
    "error": {
      "oneOf": [
        {"$ref": "#/$defs/error"},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retriable"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^IS_[A-Z0-9_]+$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "retriable": {
          "type": "boolean"
        }
      }
    }
  }
}
