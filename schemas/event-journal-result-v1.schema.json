{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/drwbkr1/incidentseal/main/schemas/event-journal-result-v1.schema.json",
  "title": "IncidentSeal event journal append result v1",
  "description": "The stable result of an inserted or exact-byte replayed journal record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "disposition",
    "run_id",
    "sequence",
    "idempotency_key",
    "event_digest",
    "link_digest",
    "event_count",
    "root_digest",
    "lifecycle",
    "verdict",
    "terminal"
  ],
  "properties": {
    "schema_version": {"const": "incidentseal-event-journal-result/v1"},
    "disposition": {"enum": ["inserted", "replayed"]},
    "run_id": {"$ref": "#/$defs/uuid"},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "idempotency_key": {"$ref": "#/$defs/sha256"},
    "event_digest": {"$ref": "#/$defs/sha256"},
    "link_digest": {"$ref": "#/$defs/sha256"},
    "event_count": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "root_digest": {"$ref": "#/$defs/sha256"},
    "lifecycle": {"enum": ["queued", "running", "completed", "cancelled", "failed", "stale", "superseded"]},
    "verdict": {
      "oneOf": [
        {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "INVALID"]},
        {"type": "null"}
      ]
    },
    "terminal": {"type": "boolean"}
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
