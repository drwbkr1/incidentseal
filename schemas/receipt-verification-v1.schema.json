{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/drwbkr1/incidentseal/main/schemas/receipt-verification-v1.schema.json",
  "title": "IncidentSeal receipt verification v1",
  "description": "A closed result from read-only independent verification of one portable receipt bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_digest",
    "expected_receipt_digest",
    "identity_status",
    "schema_status",
    "semantic_status",
    "chain_status",
    "artifact_status",
    "verification_verdict",
    "run_lifecycle",
    "run_verdict",
    "event_count",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "incidentseal-receipt-verification/v1"},
    "receipt_digest": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "expected_receipt_digest": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "identity_status": {"enum": ["MATCH", "MISMATCH", "UNBOUND", "INVALID"]},
    "schema_status": {"enum": ["PASS", "FAIL", "NOT_CHECKED"]},
    "semantic_status": {"enum": ["PASS", "FAIL", "NOT_CHECKED"]},
    "chain_status": {"enum": ["PASS", "FAIL", "NOT_CHECKED"]},
    "artifact_status": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "NOT_CHECKED"]},
    "verification_verdict": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "INVALID"]},
    "run_lifecycle": {
      "oneOf": [
        {"enum": ["queued", "running", "completed", "cancelled", "failed", "stale", "superseded"]},
        {"type": "null"}
      ]
    },
    "run_verdict": {
      "oneOf": [
        {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "INVALID"]},
        {"type": "null"}
      ]
    },
    "event_count": {
      "oneOf": [
        {"type": "integer", "minimum": 0, "maximum": 1000000},
        {"type": "null"}
      ]
    },
    "errors": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/error"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retriable"],
      "properties": {
        "code": {"type": "string", "pattern": "^IS_[A-Z0-9_]+$", "maxLength": 100},
        "message": {"type": "string", "minLength": 1, "maxLength": 1000},
        "retriable": {"type": "boolean"}
      }
    }
  }
}
