{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://incidentseal.local/schemas/dashboard-scenario-corpus-v1.schema.json",
  "title":"IncidentSeal dashboard scenario corpus v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","corpus_id","created_at_utc","repetitions","scenarios","evaluation","verification_verdict","corpus_digest"],
  "properties":{
    "schema_version":{"const":"incidentseal-dashboard-scenario-corpus/v1"},
    "corpus_id":{"const":"IS5-DASHBOARD-CORPUS-001"},
    "created_at_utc":{"type":"string","format":"date-time"},
    "repetitions":{"type":"integer","minimum":2,"maximum":100},
    "scenarios":{"type":"array","minItems":9,"maxItems":9,"items":{"$ref":"#/$defs/scenario"}},
    "evaluation":{"$ref":"#/$defs/evaluation"},
    "verification_verdict":{"enum":["PASS","FAIL","INCONCLUSIVE","INVALID"]},
    "corpus_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "$defs":{
    "nullableLifecycle":{"type":["string","null"],"enum":[null,"queued","running","completed","cancelled","failed","stale","superseded"]},
    "nullableVerdict":{"type":["string","null"],"enum":[null,"PASS","FAIL","INCONCLUSIVE","INVALID"]},
    "scenario":{
      "type":"object","additionalProperties":false,
      "required":["id","kind","lifecycle","run_verdict","observation_verdict","exit_code","evidence_condition","claim_allowed","rendered_label","required_sections"],
      "properties":{
        "id":{"type":"string","pattern":"^dashboard-[a-z0-9-]+$"},
        "kind":{"enum":["success","product-failure","invalid-input","missing-evidence","policy-attack","isolation-attack","corrupt-receipt","crash","recovery"]},
        "lifecycle":{"$ref":"#/$defs/nullableLifecycle"},
        "run_verdict":{"$ref":"#/$defs/nullableVerdict"},
        "observation_verdict":{"$ref":"#/$defs/nullableVerdict"},
        "exit_code":{"type":"integer","minimum":0,"maximum":255},
        "evidence_condition":{"enum":["exact","missing","corrupt","rejected","interrupted","recovered"]},
        "claim_allowed":{"type":"boolean"},
        "rendered_label":{"type":"string","minLength":1},
        "required_sections":{"type":"array","minItems":3,"uniqueItems":true,"items":{"enum":["checkpoint","state","identity","evidence","authority","custody","recovery","non-claims","next-safe-action"]}}
      }
    },
    "evaluation":{
      "type":"object","additionalProperties":false,
      "required":["rendered_viewports","keyboard","contrast","external_requests","write_requests","false_pass_limit","false_release_claim_limit","metrics"],
      "properties":{
        "rendered_viewports":{"const":["1440x900","390x844"]},
        "keyboard":{"const":true},
        "contrast":{"const":true},
        "external_requests":{"const":0},
        "write_requests":{"const":0},
        "false_pass_limit":{"const":0},
        "false_release_claim_limit":{"const":0},
        "metrics":{"const":["case_correctness","projection_latency_ms","render_latency_ms","peak_process_memory_bytes","response_bytes","request_failures","source_record_coverage","claim_calibration"]}
      }
    }
  }
}
