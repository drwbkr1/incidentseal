{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/drwbkr1/incidentseal/main/schemas/topology-render-v1.schema.json",
  "title": "IncidentSeal normalized Compose render v1",
  "description": "Security-relevant projection of a rendered Compose model for contract comparison.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_digest", "project_name", "operation_mode", "services", "networks", "volumes"],
  "properties": {
    "schema_version": {"const": "incidentseal-topology-render/v1"},
    "contract_digest": {"$ref": "topology-contract-v1.schema.json#/$defs/sha256"},
    "project_name": {"type": "string", "pattern": "^incidentseal-[0-9a-f]{16}$"},
    "operation_mode": {"enum": ["platform-validation", "workflow-execution"]},
    "services": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/service"}},
    "networks": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/network"}},
    "volumes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/volume"}}
  },
  "$defs": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "image", "user", "read_only_root", "privileged", "no_new_privileges", "cap_drop", "networks", "published_ports", "mounts", "environment_names"],
      "properties": {
        "id": {"$ref": "topology-contract-v1.schema.json#/$defs/id"},
        "image": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "user": {"type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"},
        "read_only_root": {"type": "boolean"},
        "privileged": {"type": "boolean"},
        "no_new_privileges": {"type": "boolean"},
        "cap_drop": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string"}},
        "networks": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "topology-contract-v1.schema.json#/$defs/id"}},
        "published_ports": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string"}},
        "mounts": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/mount"}},
        "environment_names": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}}
      }
    },
    "mount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "mode"],
      "properties": {
        "kind": {"enum": ["named-volume", "staged-input", "staged-output", "tmpfs"]},
        "target": {"type": "string", "pattern": "^/[^\\u0000]+$", "maxLength": 260},
        "mode": {"enum": ["ro", "rw"]}
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "driver", "internal", "attachable", "external"],
      "properties": {
        "id": {"$ref": "topology-contract-v1.schema.json#/$defs/id"},
        "driver": {"const": "bridge"},
        "internal": {"type": "boolean"},
        "attachable": {"type": "boolean"},
        "external": {"type": "boolean"}
      }
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "driver", "external"],
      "properties": {
        "id": {"$ref": "topology-contract-v1.schema.json#/$defs/id"},
        "driver": {"const": "local"},
        "external": {"type": "boolean"}
      }
    }
  }
}
