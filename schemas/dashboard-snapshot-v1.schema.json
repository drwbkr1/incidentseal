{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://incidentseal.local/schemas/dashboard-snapshot-v1.schema.json",
  "title":"IncidentSeal dashboard snapshot v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","snapshot_id","generated_at_utc","source","authority","trust_boundary","exits","states","source_records","retained_attempts","non_claims","verification_verdict","snapshot_digest"],
  "properties":{
    "schema_version":{"const":"incidentseal-dashboard-snapshot/v1"},
    "snapshot_id":{"type":"string","pattern":"^IS-DASHBOARD-SNAPSHOT-[0-9]{4}$"},
    "generated_at_utc":{"type":"string","format":"date-time"},
    "source":{"$ref":"#/$defs/source"},
    "authority":{"$ref":"#/$defs/authority"},
    "trust_boundary":{"$ref":"#/$defs/trust"},
    "exits":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/exit"}},
    "states":{"$ref":"#/$defs/states"},
    "source_records":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/record"}},
    "retained_attempts":{"$ref":"#/$defs/attempts"},
    "non_claims":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "verification_verdict":{"enum":["PASS","FAIL","INCONCLUSIVE","INVALID"]},
    "snapshot_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "$defs":{
    "digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source":{
      "type":"object","additionalProperties":false,
      "required":["repository","branch","checkpoint","tag_object","peeled_commit","tree"],
      "properties":{
        "repository":{"const":"https://github.com/drwbkr1/incidentseal.git"},
        "branch":{"const":"main"},
        "checkpoint":{"pattern":"^checkpoint-is-[0-9]{4}$"},
        "tag_object":{"pattern":"^[0-9a-f]{40}$"},
        "peeled_commit":{"pattern":"^[0-9a-f]{40}$"},
        "tree":{"pattern":"^[0-9a-f]{40}$"}
      }
    },
    "authority":{
      "type":"object","additionalProperties":false,
      "required":["approval_status","approved_workflow","workflow_executed","dashboard_creates_authority"],
      "properties":{
        "approval_status":{"enum":["MATCH","MISMATCH","MISSING","EXPIRED","INVALID"]},
        "approved_workflow":{"type":"boolean"},
        "workflow_executed":{"type":"boolean"},
        "dashboard_creates_authority":{"const":false}
      }
    },
    "trust":{
      "type":"object","additionalProperties":false,
      "required":["read_only","bind_host","allowed_methods","docker_access","approval_write_access","repository_write_access","external_network","remote_assets","analytics","telemetry"],
      "properties":{
        "read_only":{"const":true},
        "bind_host":{"const":"127.0.0.1"},
        "allowed_methods":{"const":["GET","HEAD"]},
        "docker_access":{"const":false},
        "approval_write_access":{"const":false},
        "repository_write_access":{"const":false},
        "external_network":{"const":false},
        "remote_assets":{"const":false},
        "analytics":{"const":false},
        "telemetry":{"const":false}
      }
    },
    "exit":{
      "type":"object","additionalProperties":false,
      "required":["id","status","evidence"],
      "properties":{
        "id":{"type":"string","pattern":"^EXIT-[A-Z0-9-]+$"},
        "status":{"enum":["pass","pending","fail","inconclusive","invalid"]},
        "evidence":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z0-9._/-]+$"}}
      }
    },
    "states":{
      "type":"object","additionalProperties":false,
      "required":["verification","lifecycle","missing_evidence","corrupt_evidence"],
      "properties":{
        "verification":{"type":"object","additionalProperties":false,"required":["PASS","FAIL","INCONCLUSIVE","INVALID"],"properties":{"PASS":{"type":"integer","minimum":0},"FAIL":{"type":"integer","minimum":0},"INCONCLUSIVE":{"type":"integer","minimum":0},"INVALID":{"type":"integer","minimum":0}}},
        "lifecycle":{"type":"object","additionalProperties":false,"required":["queued","running","completed","cancelled","failed","stale","superseded"],"properties":{"queued":{"type":"integer","minimum":0},"running":{"type":"integer","minimum":0},"completed":{"type":"integer","minimum":0},"cancelled":{"type":"integer","minimum":0},"failed":{"type":"integer","minimum":0},"stale":{"type":"integer","minimum":0},"superseded":{"type":"integer","minimum":0}}},
        "missing_evidence":{"type":"integer","minimum":0},
        "corrupt_evidence":{"type":"integer","minimum":0}
      }
    },
    "record":{
      "type":"object","additionalProperties":false,
      "required":["path","kind","sha256"],
      "properties":{
        "path":{"type":"string","pattern":"^(records|requirements|contracts)/[A-Za-z0-9._/-]+$"},
        "kind":{"enum":["evaluation","surface-receipt","contract","lock"]},
        "sha256":{"$ref":"#/$defs/digest"}
      }
    },
    "attempts":{
      "type":"object","additionalProperties":false,
      "required":["pass","fail","inconclusive","invalid","cancelled","failed","stale","superseded"],
      "properties":{"pass":{"type":"integer","minimum":0},"fail":{"type":"integer","minimum":0},"inconclusive":{"type":"integer","minimum":0},"invalid":{"type":"integer","minimum":0},"cancelled":{"type":"integer","minimum":0},"failed":{"type":"integer","minimum":0},"stale":{"type":"integer","minimum":0},"superseded":{"type":"integer","minimum":0}}
    }
  }
}
