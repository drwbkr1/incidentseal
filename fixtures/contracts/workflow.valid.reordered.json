      "capture": {"max_bytes": 1048576, "stderr": "full", "stdout": "full"}
    },
    {
      "timeout_seconds": 120,
      "runner": "node",
      "outputs": [],
      "network": "none",
      "inputs": ["src", "tests/node"],
      "id": "unit-node",
      "expected_exit_codes": [0],
      "depends_on": [],
      "cwd": ".",
      "command": ["node", "--test", "tests/node"],
      "capture": {"max_bytes": 1048576, "stderr": "full", "stdout": "full"}
    }
  ],
  "workflow_id": "example.release",
