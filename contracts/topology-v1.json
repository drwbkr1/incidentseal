  "evidence_policy": {
    "preserve_verdicts": ["PASS", "FAIL", "INCONCLUSIVE", "INVALID"],
    "preserve_lifecycle": ["queued", "running", "completed", "cancelled", "failed", "stale", "superseded"],
    "retain_attempts": "all",
    "config_render_is_runtime_proof": false,
    "source_tests_are_runtime_proof": false
