  "decision": {
    "status": "remediate",
    "next_action": "Archive this exact contract and its locks, then version a distinct incidentseal_admin bootstrap/migration role and incidentseal_runner login role. The migration must revoke public schema creation, grant only required schema and table DML to the runner, remain idempotent, and replay topology plus database gates on a new digest-bound volume.",
    "prohibited_shortcuts": [
      "Do not accept the bootstrap superuser as an application runner role.",
      "Do not grant CREATE on the public schema or broad database ownership to the runner.",
      "Do not introduce a password, secret, external network, root runtime, or privileged helper.",
